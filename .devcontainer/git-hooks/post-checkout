#!/bin/sh

# Git passes 1 for a branch checkout and 0 for a file checkout.
[ "${3:-0}" = 1 ] || exit 0
[ "$(git symbolic-ref --quiet --short HEAD)" = main ] || exit 0
changes=$(git status --porcelain) || exit 0
[ -z "$changes" ] || exit 0

if ! GIT_TERMINAL_PROMPT=0 git fetch --quiet origin refs/heads/main; then
    printf '%s\n' 'Automatisch bijwerken van main is overgeslagen: ophalen is mislukt.' >&2
    exit 0
fi

# Recheck in case the editor saved a file while Git was fetching.
[ "$(git symbolic-ref --quiet --short HEAD)" = main ] || exit 0
changes=$(git status --porcelain) || exit 0
[ -z "$changes" ] || exit 0
if ! git merge --ff-only --quiet FETCH_HEAD; then
    printf '%s\n' 'Automatisch bijwerken van main is overgeslagen. Controleer je wijzigingen in Source Control.' >&2
fi
exit 0
